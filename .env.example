# Copy this file to .env.local and fill in the values. .env.local is git-ignored.
# These are read only by the Vite dev server; they are never sent to the browser.

# SDC.Api base URL (the "https" launch profile).
CLAIMS_API_URL=https://localhost:7299

# Website client registered under ApiClients:Clients in SDC.Api.
# The API key is the plain key printed by `dotnet SDC.Api.dll generate-api-key claims-web`
# (appsettings only stores its SHA-256 hash).
CLAIMS_CLIENT_ID=claims-web
CLAIMS_API_KEY=

# Temporary, until the site has its own login screen:
# an LMS account assigned to at least one dealer. Claims are submitted under this account.
CLAIMS_DEV_LOGIN=
CLAIMS_DEV_PASSWORD=
